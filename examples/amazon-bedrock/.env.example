# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# AWS Configuration
# Credentials resolve in this order: AWS_BEARER_TOKEN_BEDROCK (Bedrock API key), then
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY(/AWS_SESSION_TOKEN), then AWS_PROFILE, then the
# default boto3 chain (shared config, SSO, IRSA, instance role).
AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# Amazon Bedrock Model Configuration
# LLM uses the Converse API, so any Bedrock chat model works (gpt-oss, Claude, Nova, ...)
BEDROCK_LLM_MODEL=openai.gpt-oss-120b-1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_RERANKER_MODEL=cohere.rerank-v3-5:0
